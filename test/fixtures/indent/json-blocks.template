{% if Request.IsMobileDevice %}
  <div class="menu">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "itemListElement": [
          {% for item in Menu %}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "name": "{{ item.Name }}"
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  </div>
{% endif %}
